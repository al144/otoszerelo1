@page
@model otoszerelo.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Ügyfél szerkesztése";
}

<div class="page-heading">
    <div><span class="eyebrow">ÜGYFÉLKEZELÉS</span><h1>Ügyfél szerkesztése</h1><p>Módosítsd az ügyfél adatait.</p></div>
    <a class="btn btn-outline-secondary" asp-page="Index">← Vissza</a>
</div>
<section class="content-panel form-panel">
    <form method="post">
        <input type="hidden" asp-for="Customer.Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field-group"><label asp-for="Customer.Name"></label><input asp-for="Customer.Name" class="form-control" autocomplete="name" /><span asp-validation-for="Customer.Name" class="field-error"></span></div>
            <div class="field-group"><label asp-for="Customer.Phone"></label><input asp-for="Customer.Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Customer.Phone" class="field-error"></span></div>
            <div class="field-group full-width"><label asp-for="Customer.Email"></label><input asp-for="Customer.Email" class="form-control" autocomplete="email" /><span asp-validation-for="Customer.Email" class="field-error"></span></div>
        </div>
        <div class="form-actions"><a class="btn btn-outline-secondary" asp-page="Index">Mégse</a><button type="submit" class="btn btn-primary">Változtatások mentése</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
