@page
@model otoszerelo.Pages.Customers.DetailsModel
@{
    ViewData["Title"] = "Ügyfél adatlap";
}

<div class="page-heading">
    <div><span class="eyebrow">ÜGYFÉL ADATLAP</span><h1>@Model.Customer.Name</h1><p>@(Model.Customer.Phone ?? "Nincs telefonszám") <span class="muted-separator">·</span> @(Model.Customer.Email ?? "Nincs e-mail-cím")</p></div>
    <div class="heading-actions"><a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@Model.Customer.Id">Szerkesztés</a><a class="btn btn-outline-secondary" asp-page="Index">← Ügyfelek</a></div>
</div>
<section class="stats-grid detail-stats">
    <article class="stat-card"><span class="stat-label">Összes javítás</span><strong>@Model.Customer.Repairs.Count</strong><span class="stat-footnote">Rögzített munkalap</span></article>
    <article class="stat-card"><span class="stat-label">Összköltség</span><strong>@Model.TotalCost.ToString("N0") <small>Ft</small></strong><span class="stat-footnote">Megadott javítási költségek</span></article>
</section>
<section class="content-panel">
    <div class="section-heading compact-heading"><h2>Javítási előzmények</h2></div>
    @if (Model.Customer.Repairs.Count == 0)
    {
        <p class="empty-state">Ehhez az ügyfélhez még nem tartozik javítás.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table workshop-table align-middle mb-0">
                <thead><tr><th>JÁRMŰ</th><th>JAVÍTÁS</th><th>FELVÉVE</th><th>ÁLLAPOT</th><th class="text-end">KÖLTSÉG</th></tr></thead>
                <tbody>
                @foreach (var repair in Model.Customer.Repairs)
                {
                    <tr><td><strong>@repair.Vehicle</strong><span class="table-subtext">@repair.LicensePlate</span></td><td>@repair.Description</td><td>@repair.CreatedAt.ToLocalTime().ToString("yyyy. MMM d.")</td><td><span class="status-badge status-@repair.Status.ToString().ToLowerInvariant()">@repair.StatusName</span></td><td class="text-end">@(repair.Cost.HasValue ? $"{repair.Cost.Value:N0} Ft" : "—")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
